 	uint8_t *enc_record;
 	size_t enc_record_len;
 	ssize_t ret = 0;
@@ -724,23 +724,15 @@ tls13_record_layer_seal_record_protected(struct tls13_record_layer *rl,
 	if (enc_record_len > TLS13_RECORD_MAX_CIPHERTEXT_LEN)
